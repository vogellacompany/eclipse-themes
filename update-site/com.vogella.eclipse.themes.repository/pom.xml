<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.vogella.eclipse.themes</groupId>
    <artifactId>com.vogella.eclipse.themes.parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>com.vogella.eclipse.themes.repository</artifactId>
  <packaging>eclipse-repository</packaging>

  <!-- Build order only: the legacy repository is mirrored into this one below -->
  <dependencies>
    <dependency>
      <groupId>com.vogella.eclipse.themes</groupId>
      <artifactId>com.vogella.eclipse.themes.repository.legacy</artifactId>
      <version>${project.version}</version>
      <type>eclipse-repository</type>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Resolves against the modern target, so the modern variant is the one this
           resolution keeps; the legacy variant is merged in from its own repository -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <configuration>
          <target>
            <file>${modern.target}</file>
          </target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho.extras</groupId>
        <artifactId>tycho-p2-extras-plugin</artifactId>
        <version>${tycho.version}</version>
        <executions>
          <execution>
            <id>merge-legacy-repository</id>
            <phase>package</phase>
            <goals>
              <goal>mirror</goal>
            </goals>
            <configuration>
              <source>
                <repository>
                  <url>file:${maven.multiModuleProjectDirectory}/update-site/com.vogella.eclipse.themes.repository.legacy/target/repository</url>
                </repository>
              </source>
              <destination>${project.build.directory}/repository</destination>
              <append>true</append>
              <xzCompress>false</xzCompress>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- PGP signs the artifacts of the update site, the key file comes from
           -Dtycho.pgp.signer.bc.secretKeys, the passphrase from MAVEN_GPG_PASSPHRASE -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-gpg-plugin</artifactId>
        <executions>
          <execution>
            <id>pgp-sign</id>
            <phase>package</phase>
            <goals>
              <goal>sign-p2-artifacts</goal>
            </goals>
            <configuration>
              <signer>bc</signer>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- No xz index files: the mirror step above would leave them stale. The archive
           must contain the merged and signed repository, so it runs after both. -->
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-p2-repository-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <xzCompress>false</xzCompress>
        </configuration>
        <executions>
          <execution>
            <id>default-archive-repository</id>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
