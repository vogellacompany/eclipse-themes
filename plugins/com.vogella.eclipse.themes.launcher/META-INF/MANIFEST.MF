 org.osgi.framework.hooks.weaving;version="[1.1.0,2.0.0)",
 org.osgi.service.prefs;version="[1.1.0,2.0.0)"
Export-Package: com.vogella.eclipse.themes.launcher;x-internal:=true
Automatic-Module-Name: com.vogella.eclipse.themes.launcher
